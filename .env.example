# CAT Smart Operator Assistant — Environment Config
# Copy this to .env and fill in as needed. All values below are the defaults.

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_SMALL_MODEL=qwen2.5:1.5b

# API
API_HOST=0.0.0.0
API_PORT=8000

# Site config
SITE_ID=site_1
DEFAULT_OPERATOR=OP001
DEFAULT_MACHINE=EXC001
